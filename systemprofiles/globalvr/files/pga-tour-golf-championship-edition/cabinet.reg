Windows Registry Editor Version 5.00

; PGA TOUR Golf Championship Edition (Global VR, 1.2): the cabinet's registry. The frontend's
; ActiveX control (C:\Orion\ShellControl.ocx, its registration) and the shell's and game's
; settings, from the game's install CD (its _Registry, copied to the dump: ShellControl.reg,
; GVRShell.reg, HKLM EaSports.reg, HKLM EA.reg, HKLM Courses.reg, HKCU EaSports.reg, HKLM
; Fonts.reg), with free play (the shell's Pay4Play). The install CD's REG_EXPAND_SZ values
; (hex(2): the courses' files) are plain strings, as Championship Edition II's (the game got them
; as UTF-16 text). Imported at each launch.

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}]
@="ShellControl Control"
"AppID"="{1745C205-067B-11D6-B8E9-0040CAB4F670}"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\ProgID]
@="SHELLCONTROL.ShellControlCtrl.1"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\InprocServer32]
@="C:\\Orion\\ShellControl.ocx"
"ThreadingModel"="Apartment"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\ToolboxBitmap32]
@="C:\\Orion\\ShellControl.ocx, 1"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\MiscStatus]
@="0"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\MiscStatus\1]
@="132241"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\Control]
@=""

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\TypeLib]
@="{1745C202-067B-11D6-B8E9-0040CAB4F670}"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\Version]
@="1.0"

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\Implemented Categories]

[HKEY_LOCAL_MACHINE\Software\CLASSES\CLSID\{1745C205-067B-11D6-B8E9-0040CAB4F670}\Implemented Categories\{7DD95801-9882-11CF-9FA9-00AA006C42C4}]

