[-HKEY_LOCAL_MACHINE\Software\Tsunami\Apps\ReVolt\Options\Language]

[HKEY_LOCAL_MACHINE\Software\Tsunami\Apps\ReVolt\Options\ContinueTimeout]
@="int"
"min"=dword:00000000
"max"=dword:0000001e
"step"=dword:00000005
"default"=dword:0000000f
"name"="Continue Timer Length"

[HKEY_LOCAL_MACHINE\Software\Tsunami\Apps\ReVolt\Options\ContestDaysRemaining]
@="int"
"min"=dword:00000000
"max"=dword:0000016d
"step"=dword:00000001
"default"=dword:00000000
"name"="Remaining Contest Days"

[HKEY_LOCAL_MACHINE\SOFTWARE\Tsunami\Apps\ReVolt\Options\ClearScores]
@="delRegKey"
