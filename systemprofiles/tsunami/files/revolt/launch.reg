"name"="ReVolt"
"launchGame"="c:\\games\\ReVolt\\ReVolt.exe -launchgame"
"launchAttract"="c:\\games\\ReVolt\\ReVolt.exe -launchattract"
"launchBitmap"="c:\\games\\ReVolt\\launch.bmp"
"launchMarquee"="c:\\games\\ReVolt\\ReVolt.tga"
