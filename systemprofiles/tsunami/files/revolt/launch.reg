[HKEY_LOCAL_MACHINE\SOFTWARE\Tsunami\Apps\ReVolt\Options]
@="ContinueTimeout;ClearScores"
"ContestDaysRemaining"=dword:00000000
"Difficulty"=-
"MotionFilter"=-
"WheelMid"=-
"WheelMax"=-
