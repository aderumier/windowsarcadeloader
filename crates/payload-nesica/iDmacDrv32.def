; Ordinals of the Taito iDmacDrv32.dll driver: games import these functions by ordinal.
LIBRARY iDmacDrv32
EXPORTS
    iDmacDrvOpen @1
    iDmacDrvClose @2
    iDmacDrvDmaRead @3
    iDmacDrvDmaWrite @4
    iDmacDrvRegisterRead @5
    iDmacDrvRegisterWrite @6
    iDmacDrvRegisterBufferRead @7
    iDmacDrvRegisterBufferWrite @8
    iDmacDrvMemoryRead @9
    iDmacDrvMemoryWrite @10
    iDmacDrvMemoryBufferRead @11
    iDmacDrvMemoryBufferWrite @12
    iDmacDrvMemoryReadExt @13
    iDmacDrvMemoryWriteExt @14
    ; NESiCAxLive 2 API (NxL2Core.dll), imported by name
    NxL2AddBookkeeping
    NxL2CancelRequestRFID
    NxL2CheckStoreOpenTime
    NxL2DecreaseCoinCount
    NxL2Delete
    NxL2EnableWdt
    NxL2GetAppicationStep
    NxL2GetAutoEndLockCount
    NxL2GetAutoEndRemainderTime
    NxL2GetCoinCount
    NxL2GetCoinStatus
    NxL2GetDllVersion
    NxL2GetGameID
    NxL2GetGameSettingA
    NxL2GetGameSettingW
    NxL2GetIOStatus
    NxL2GetInput
    NxL2GetRFIDID
    NxL2GetRFIDResult
    NxL2GetSystemSettingA
    NxL2GetSystemSettingW
    NxL2Init
    NxL2IsOlderVersion
    NxL2IsRFIDRead
    NxL2LockAutoEnd
    NxL2NotifyCredit
    NxL2NotifyEndApplication
    NxL2RequestRFID
    NxL2SetGameSettingA
    NxL2SetGameSettingW
    NxL2UnlockAutoEnd
    NxL2Update
    NxL2UpdateGameSetting
    ; Theatrhythm Final Fantasy All-Star Carnival's plugins, imported by name
    ismACIO_DecreaseCoin
    ismACIO_Delete
    ismACIO_GetCoin
    ismACIO_GetCoinStatus
    ismACIO_GetInputA
    ismACIO_GetInputD
    ismACIO_GetStatus
    ismACIO_Init
    ismACIO_SetOutputA
    ismACIO_SetOutputD
    ismACIO_Update
    NESiCAReaderCancelRead
    NESiCAReaderClose
    NESiCAReaderGetID
    NESiCAReaderGetResult
    NESiCAReaderGetStatus
    NESiCAReaderGetXioStatus
    NESiCAReaderOpen
    NESiCAReaderRead
    NESiCAReaderUpdate
    NESYS_CARD_INSERT_REQUEST
    NESYS_CARD_REISSUE_REQUEST
    NESYS_CLOSE_REQUEST_HANDLE
    NESYS_GET_CARDDATA_REQUEST
    NESYS_GET_CERTINFO
    NESYS_GET_CERT_NAME
    NESYS_GET_LANINTERFACE
    NESYS_GET_LIBRARY_VER
    NESYS_GET_LOCALSEARCH
    NESYS_GET_LOCALSEARCH_ENTRY_NUM
    NESYS_GET_MAINTENANCE_TIME
    NESYS_GET_NETWORK_ERROR_CODE
    NESYS_GET_NETWORK_STATUS
    NESYS_GET_PLAYLOG_REQUEST
    NESYS_GET_REQUEST_RECIEVED_DATA
    NESYS_GET_REQUEST_STATUS
    NESYS_INIT
    NESYS_GET_SERVER_URL
    NESYS_NOTIFY_INCOME_REQUEST
    NESYS_PARSE_JSON
    NESYS_RELEASE
    NESYS_RESTART_ONLINE_MODE
    NESYS_SET_DEBUG_LOGGER
    NESYS_START_LOCALSEARCH
    NESYS_START_ONLINE_MODE
    NESYS_STOP_ONLINE_MODE
    NESYS_UPDATE
