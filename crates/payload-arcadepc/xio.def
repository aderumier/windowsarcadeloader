; xio.dll exports (Frenzy Express, xio.rs; x86 build only): MSVC names of the XIO class's
; thiscall methods and of its bytes.
    "??0XIO@@QAE@XZ" = xio_new
    "??1XIO@@QAE@XZ" = xio_none
    "?closeInterface@XIO@@QAEXXZ" = xio_none
    "?openInterface@XIO@@QAEHXZ" = xio_open
    "?initialize@XIO@@QAEXXZ" = xio_reset_pedals
    "?initLamp@XIO@@QAEXXZ" = xio_none
    "?initPedal@XIO@@QAEXXZ" = xio_reset_pedals
    "?initSteering@XIO@@QAEXXZ" = xio_none
    "?initVibration@XIO@@QAEXXZ" = xio_none
    "?resetPedal@XIO@@QAEXXZ" = xio_reset_pedals
    "?update@XIO@@QAEXXZ" = xio_update
    "?updateCoinCounter@XIO@@QAEXXZ" = xio_none
    "?updateHandleState@XIO@@QAEXXZ" = xio_none
    "?updateInputState@XIO@@QAEXXZ" = xio_none
    "?updateLampState@XIO@@QAEXXZ" = xio_none
    "?updatePedalState@XIO@@QAEXXZ" = xio_none
    "?getSteeringBar@XIO@@QAEEXZ" = xio_handle
    "?getVibration@XIO@@QAEEXZ" = xio_zero
    "?lamp@XIO@@QAEXE@Z" = xio_none1
    "?leftLamp@XIO@@QAEXE@Z" = xio_none1
    "?rightLamp@XIO@@QAEXE@Z" = xio_none1
    "?selectLamp@XIO@@QAEXH@Z" = xio_none1
    "?startLamp@XIO@@QAEXH@Z" = xio_none1
    "?setSteeringBar@XIO@@QAEXE@Z" = xio_none1
    "?setVibration@XIO@@QAEXEH@Z" = xio_none2
    "?g_bKeyImm@@3EA" = XIO_KEY_IMM DATA
    "?g_bKeyExc@@3EA" = XIO_KEY_EXC DATA
    "?g_bHandle@@3EA" = XIO_HANDLE DATA
    "?g_bBrake@@3EA" = XIO_BRAKE DATA
    "?g_bAccelerator@@3EA" = XIO_ACCELERATOR DATA
    "?g_bLAccel@@3EA" = XIO_L_ACCEL DATA
    "?g_bRAccel@@3EA" = XIO_R_ACCEL DATA
    "?g_bLAccelDif@@3EA" = XIO_L_ACCEL_DIF DATA
    "?g_bRAccelDif@@3EA" = XIO_R_ACCEL_DIF DATA
    "?g_bLAccelDifLast@@3EA" = XIO_L_ACCEL_DIF_LAST DATA
    "?g_bRAccelDifLast@@3EA" = XIO_R_ACCEL_DIF_LAST DATA
    "?g_bLAccelEnd@@3EA" = XIO_L_ACCEL_END DATA
    "?g_bRAccelEnd@@3EA" = XIO_R_ACCEL_END DATA
    "?leftPedalVelocity@@3EA" = XIO_L_PEDAL DATA
    "?rightPedalVelocity@@3EA" = XIO_R_PEDAL DATA
    "?lastLeftPedalVelocity@@3EA" = XIO_L_PEDAL_LAST DATA
    "?lastRightPedalVelocity@@3EA" = XIO_R_PEDAL_LAST DATA
