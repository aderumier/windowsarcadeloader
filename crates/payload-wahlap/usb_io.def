; Exports of usb_io.dll (Wahlap's USB I/O board driver), MSVC mangled cdecl C++ functions.
EXPORTS
    "?UsbIO_CheckConnection@@YA_NXZ" = usbio_check_connection
    "?UsbIO_CleanCoin@@YAHG@Z" = usbio_clean_coin
    "?UsbIO_DecCoin@@YAHGG@Z" = usbio_dec_coin
    "?UsbIO_ExitSystem@@YAXXZ" = usbio_exit_system
    "?UsbIO_GetErrorCount@@YAHXZ" = usbio_zero
    "?UsbIO_GetFramework@@YAHXZ" = usbio_one
    "?UsbIO_GetIOBroadID@@YAHXZ" = usbio_board_id
    "?UsbIO_GetInputdata@@YAHAAUUsbIOBoardInputData_s@@@Z" = usbio_get_input_data
    "?UsbIO_GetLastError@@YAHXZ" = usbio_zero
    "?UsbIO_GetLightState@@YAHAAUUsbIOBoardLightState_s@@@Z" = usbio_zero
    "?UsbIO_GetVersionH@@YAHXZ" = usbio_version_h
    "?UsbIO_GetVersionL@@YAHXZ" = usbio_version_l
    "?UsbIO_InitSystem@@YAHH@Z" = usbio_init_system
    "?UsbIO_OutputCarStatuData@@YAXAAUUsbIOBoardCarStatuData_s@@@Z" = usbio_car_status
    "?UsbIO_ReadFailDecCoins@@YAHI@Z" = usbio_zero
    "?UsbIO_ReadSysCoins@@YAHI@Z" = usbio_read_sys_coins
    "?UsbIO_SetBoostEffect@@YAX_N@Z" = usbio_ignore
    "?UsbIO_SetBoostThreshold@@YAXH@Z" = usbio_ignore
    "?UsbIO_SetCollisionData@@YAXAAUUsbIOBoardCollisionData_s@@@Z" = usbio_ignore
    "?UsbIO_SetDrifting@@YAXM@Z" = usbio_ignore
    "?UsbIO_SetGamePlayStatu@@YAX_N@Z" = usbio_ignore
    "?UsbIO_SetLedLightStatu@@YAXAAUUsbIOBoardLEDLightStatu_s@@@Z" = usbio_ignore
    "?UsbIO_SetLightState@@YAHAAUUsbIOBoardLightState_s@@@Z" = usbio_zero
    "?UsbIO_SetMenuGear@@YAX_N@Z" = usbio_ignore
    "?UsbIO_SetMoterVolt@@YAXH@Z" = usbio_set_motor_volt
    "?UsbIO_SetOutputdata@@YAHAAUUsbIOBoardOutputData_s@@@Z" = usbio_one
    "?UsbIO_SetPWMLightStatu@@YAXAAUUsbIOBoardPWMLightStatu_s@@@Z" = usbio_ignore
    "?UsbIO_SetPowerFactor@@YAXM@Z" = usbio_ignore
    "?UsbIO_SetPowerPause@@YAXXZ" = usbio_ignore
    "?UsbIO_SetRoadBasicStatu@@YAXAAUUsbIOBoardSetRoadData_s@@@Z" = usbio_ignore
    "?UsbIO_SetRoadType@@YAXH@Z" = usbio_set_road_type
    "?UsbIO_SetSeatShakeImpluse@@YAXHHM_N@Z" = usbio_ignore
    "?UsbIO_SetSteerCenter@@YAXH@Z" = usbio_set_steer_center
    "?UsbIO_SetSteeringStatu@@YAHAAUUsbIOBoardSteeringStatu@@@Z" = usbio_set_steering_status
    "?UsbIO_SetValueGuard@@YAX_N@Z" = usbio_ignore
    "?UsbIO_UserControlMemoryRead@@YAHPAEGG@Z" = usbio_zero
    "?UsbIO_UserControlMemoryWrite@@YAHPAEGG@Z" = usbio_zero
