    "?addOutgoingPacket@GvrNetComm@1Gvr@@QAEXPAXKW4gvrSendType@12@PAD@Z" = netcomm_add_packet
; COM in-process server of the Anark player's logger (aklog.rs), when a registry layer names it.
    DllGetClassObject PRIVATE
    DllCanUnloadNow PRIVATE
