; Exports of USBIOExtreme.dll the game imports (by name), MSVC mangled C++ methods of CUSBIO.
EXPORTS
    "??0CUSBIO@@QAE@XZ" = cusbio_new
    "??1CUSBIO@@QAE@XZ" = cusbio_drop
    "?CUSBIO_Init@CUSBIO@@QAEHXZ" = cusbio_init
    "?CUSBIO_Update@CUSBIO@@QAEXH@Z" = cusbio_update
    "?CUSBIO_GetLastError@CUSBIO@@QAEPADH@Z" = cusbio_last_error
    "?CUSBIO_Close@CUSBIO@@QAEXXZ" = cusbio_close
; UsbTrackerDll.dll (PGA TOUR's trackball board, pga_trackball.rs): its update and memory
    "?CUSBIO_Update@CUSBIO@@QAEXXZ" = pga_trackball_update
    pga_trackball_init
    "?ReadSPIMemory@CUSBIO@@QAEXEPAE@Z" = pga_trackball_read_spi
    "?WriteSPIMemory@CUSBIO@@QAEXEPAE@Z" = pga_trackball_write_spi
; PGA TOUR Golf Team Challenge's engine: USBIOExtreme's board memory (a device argument)
    "?ReadSPIMemory@CUSBIO@@QAEXHEPAE@Z" = team_challenge_read_spi
    "?WriteSPIMemory@CUSBIO@@QAEXHEPAE@Z" = team_challenge_write_spi
; the cabinet monitors (Need for Speed Carbon's GVRCoinMonitor.exe, GVRVolumeMonitor.exe)
    "?SetEncoderThreadState@CUSBIO@@QAEXH@Z" = cusbio_encoder_thread
    "?SetOutputValue@CUSBIO@@QAEXHEEE@Z" = cusbio_output
; GVRInputRaw.dll (driving cabinets, gvrinput.rs), cdecl functions imported by name; the
; older library (Beach Head 2002, turret.rs) has only cleanup, init and update, loaded by ordinal.
    GVRInputRawInit = gvr_init @2
    GVRInputRawUpdate = gvr_update @3
    GVRInputRawCleanup = gvr_none @1
    ; the 27-export library (PGA TOUR's shell control) by its ordinals: 20 init, 25 update
    GVRInputRawInitOrdinal = gvr_init_ordinal @20 NONAME
    GVRInputRawUpdateOrdinal = gvr_update @25 NONAME
    GVRInputRawSleep = gvr_none
    GVRInputRawWake = gvr_none
    GVRInputRawResetCalibration = gvr_none
    GVRInputRawResetImmersion = gvr_none
    GVRInputRawReadDrivingValues = gvr_driving_values
    GVRInputRawWriteDrivingValues = gvr_driving_values
    GVRInputRawGetCUSBIO = gvr_cusbio
    GVRInputRawHandleDeviceChanged = gvr_none
    GVRInputRawSetPauseLight = gvr_none
    GVRInputRawGetAxisFault = gvr_none
    GVRInputRawGetButtonFault = gvr_none
    GVRInputRawGetFFFault = gvr_none
    GVRInputRawGetStuckAxis = gvr_none
    GVRInputRawGetStuckButtonFault = gvr_none
    GVRInputRawGetUncalibratedAxis = gvr_none
    GVRInputRawClearAxisFault = gvr_none
    GVRInputRawClearButtonFault = gvr_none
    GVRInputRawClearFFFault = gvr_none
    GVRInputRawClearStuckAxis = gvr_none
    GVRInputRawClearStuckButtonFault = gvr_none
    GVRInputRawClearUncalibratedAxis = gvr_none
    GVRInputRawIncAxisFault = gvr_none
    GVRInputRawIncButtonFault = gvr_none
    GVRInputRawIncFFFault = gvr_none
    GVRInputRawIncStuckAxis = gvr_none
    GVRInputRawIncUncalibratedAxis = gvr_none
    ; the newer library (Need for Speed Underground): its card dispenser, none here
    GVRInputRawGetCardStatus = gvr_card_status
    GVRInputRawGetCardShutdown = gvr_none
    GVRInputRawDispenseCard = gvr_none
    GVRInputRawSetMode = gvr_none
    GVRInputRawSetInterfaceType = gvr_none
; GvrIO.dll (Need for Speed Carbon, gvrio.rs): the cGvrIO class and the message function.
    "??0cGvrIO@GvrIO@Zeus@Gvr@@QAE@XZ" = gvrio_new
    "??1cGvrIO@GvrIO@Zeus@Gvr@@QAE@XZ" = gvrio_drop
    "?Initialize@cGvrIO@GvrIO@Zeus@Gvr@@QAE_NW4GVR_DEVICE_TYPES@234@PAUHWND__@@P6APAXPAUsMessage@234@@Z@Z" = gvrio_initialize
    ; the newer library (Redline Rampage): one more argument
    "?Initialize@cGvrIO@GvrIO@Zeus@Gvr@@QAE_NW4GVR_DEVICE_TYPES@234@PAUHWND__@@P6APAXPAUsMessage@234@@ZI@Z" = gvrio_initialize_ex
    "?MessageRegisterCallback@cGvrIO@GvrIO@Zeus@Gvr@@QAE_NW4GVR_DEVICE_TYPES@234@P6APAXPAUsMessage@234@@Z@Z" = gvrio_register_callback
    "?GvrIOMessageSend@GvrIO@Zeus@Gvr@@YAPAXPAUsMessage@123@@Z" = gvrio_send
; GVRSCR28.dll (Need for Speed Carbon's frontend, smartcard.rs): the card reader.
    CreateGVRStorageDeviceImp = smartcard_create
    ReleaseGVRStorageDeviceImp = smartcard_release
; gvrNetComm.dll (NASCAR Team Racing's race, netcomm.rs): no cabinet linked.
    "??0GvrNetComm@0Gvr@@QAE@XZ" = netcomm_new
    "??1GvrNetComm@0Gvr@@QAE@XZ" = netcomm_none
